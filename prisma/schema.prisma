generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String               @id @default(cuid())
  name         String
  alias        String?
  email        String               @unique
  passwordHash String
  isAdmin      Boolean              @default(false)
  createdAt    DateTime             @default(now())
  prediction   Prediction?
  resetTokens  PasswordResetToken[]
}

model Prediction {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  submittedAt       DateTime  @default(now())
  isLocked          Boolean   @default(false)   // fase 1 bloqueada
  isPhase2Locked    Boolean   @default(false)   // fase 2 bloqueada
  phase2SubmittedAt DateTime?
  // JSON fields stored as strings
  groupPredictions String   @default("{}") // {A:{winner:"MEX",runnerUp:"KOR"}, ...}
  thirdPlacePicks  String   @default("[]") // ["MEX","BRA",...] - 8 team codes
  knockoutPicks    String   @default("{}") // {73:"MEX", 74:"GER", ...}
  topScorerTeam    String?  // team code
  mvpTeam          String?  // team code
  // Scoring (populated by admin recalculation)
  groupPoints      Int      @default(0)
  thirdPlacePoints Int      @default(0)
  knockoutPoints   Int      @default(0)
  specialPoints    Int      @default(0)
  totalPoints      Int      @default(0)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model TournamentResult {
  id           String   @id @default("singleton")
  // JSON: {A:{1:"MEX",2:"KOR",3:"ZAF",4:"CZE"}, ...}
  groupResults String   @default("{}")
  // JSON: {73:"MEX", 74:"GER", ...} - match number to winner team code
  matchResults String   @default("{}")
  // 8 team codes that qualified as best 3rd-place teams
  thirdPlaceQualifiers String @default("[]")
  // JSON: {74:"BRA", 77:"MEX", ...} — admin manual assignment of each 3rd-place team to R32 match slot
  thirdPlaceAssignment String @default("{}")
  topScorer    String?
  mvp          String?
  updatedAt    DateTime @updatedAt
}

model AppSettings {
  id                 String    @id @default("singleton")
  predictionDeadline DateTime?   // cierre fase 1 (grupos + terceros)
  phase2Deadline     DateTime?   // cierre fase 2 (eliminatorias + premios)
  registrationOpen   Boolean   @default(true)
  updatedAt          DateTime  @updatedAt
}
